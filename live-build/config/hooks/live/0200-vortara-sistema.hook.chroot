#!/bin/sh
# Ajustes del sistema: idioma, servicios y valores por defecto del escritorio.
set -e

# Idiomas: español por defecto, inglés disponible.
sed -i -e 's/^# *\(es_ES.UTF-8 UTF-8\)/\1/' -e 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen
locale-gen
update-locale LANG=es_ES.UTF-8

# Valores por defecto de Cinnamon (tema oscuro, fondo, favoritos).
glib-compile-schemas /usr/share/glib-2.0/schemas

# Servicios propios.
systemctl enable vortara-flathub.service
systemctl enable zramswap.service || true

# Política de actualizaciones: solo notificar. Nada se instala solo.
apt-get purge -y unattended-upgrades 2>/dev/null || true

# Logo para iconos del sistema (LOGO= en os-release).
for size in 16 22 24 32 48 64 128 256; do
	d=/usr/share/icons/hicolor/${size}x${size}/apps
	mkdir -p "$d"
	cp /usr/share/pixmaps/vortara-logo-${size}.png "$d/vortara-logo.png" 2>/dev/null || true
done
mkdir -p /usr/share/icons/hicolor/scalable/apps
cp /usr/share/pixmaps/vortara-logo.svg /usr/share/icons/hicolor/scalable/apps/vortara-logo.svg
gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
