#!/bin/sh
# Marca de Vortara en el instalador Calamares (parte de la configuración de Debian).
set -e

[ -d /etc/calamares ] || exit 0

src=/etc/calamares/branding/debian
dst=/etc/calamares/branding/vortara
mkdir -p "$dst"
cp -a "$src"/. "$dst"/
cp /usr/share/pixmaps/vortara-logo-256.png "$dst/vortara-logo.png"
cp /usr/share/pixmaps/vortara-calamares-bienvenida.png "$dst/vortara-bienvenida.png"
cp /usr/share/vortara/calamares/show.qml "$dst/show.qml"

sed -i \
	-e 's/^componentName:.*/componentName:  vortara/' \
	-e 's/^\( *productName:\).*/\1         "Vortara OS"/' \
	-e 's/^\( *shortProductName:\).*/\1    "Vortara"/' \
	-e 's/^\( *version:\).*/\1             "@VORTARA_VERSION@"/' \
	-e 's/^\( *shortVersion:\).*/\1        "@VORTARA_VERSION@"/' \
	-e 's/^\( *versionedName:\).*/\1       "Vortara OS @VORTARA_VERSION@ (@VORTARA_CODENAME_PRETTY@)"/' \
	-e 's/^\( *shortVersionedName:\).*/\1  "Vortara @VORTARA_VERSION@"/' \
	-e 's/^\( *productLogo:\).*/\1         "vortara-logo.png"/' \
	-e 's/^\( *productIcon:\).*/\1         "vortara-logo.png"/' \
	-e 's/^\( *productWelcome:\).*/\1      "vortara-bienvenida.png"/' \
	-e 's|^\( *productUrl:\).*|\1          https://github.com/mmr193226/Vortara-OS|' \
	-e 's|^\( *supportUrl:\).*|\1          https://github.com/mmr193226/Vortara-OS/issues|' \
	-e 's|^\( *knownIssuesUrl:\).*|\1      https://github.com/mmr193226/Vortara-OS/issues|' \
	-e 's|^\( *releaseNotesUrl:\).*|\1     https://github.com/mmr193226/Vortara-OS/blob/main/docs/DECISIONES.md|' \
	-e 's|^\( *donateUrl:\).*|\1           https://github.com/mmr193226/Vortara-OS|' \
	-e 's|^\( *SidebarBackground:\).*|\1    "#0B1F1D"|' \
	-e 's|^\( *SidebarText:\).*|\1          "#E6FFFA"|' \
	-e 's|^\( *SidebarTextCurrent:\).*|\1   "#FFFFFF"|' \
	-e 's|^\( *SidebarBackgroundCurrent:\).*|\1 "#0F766E"|' \
	"$dst/branding.desc"

sed -i 's/^branding:.*/branding: vortara/' /etc/calamares/settings.conf

# bootloaderEntryName se deja como en Debian: el GRUB firmado para Secure Boot
# busca su configuración en \EFI\debian. El menú de GRUB dirá "Vortara"
# gracias a GRUB_DISTRIBUTOR (/etc/default/grub.d/vortara.cfg).

# Espacio mínimo: el sistema instalado ocupa ~6 GB; 10 GB deja margen.
sed -i 's/^\( *requiredStorage:\).*/\1    10/' /etc/calamares/modules/welcome.conf

# Al instalar, quitar también el instalador y las herramientas del modo live.
sed -i "s/^      - 'calamares-settings-debian'/      - 'calamares-settings-debian'\n      - 'calamares'\n      - 'user-setup'/" \
	/etc/calamares/modules/packages.conf

# El icono del escritorio lo pone /usr/libexec/vortara/lanzador-instalador;
# se quita el autostart de Debian para que no salga duplicado.
rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop

# Lanzador del instalador en español y con el logo de Vortara.
lanzador=/usr/share/applications/calamares-install-debian.desktop
if [ -f "$lanzador" ]; then
	sed -i \
		-e 's/^Name=.*/Name=Instalar Vortara/' \
		-e '/^Name\[/d' \
		-e 's/^Comment=.*/Comment=Instalar Vortara OS en este equipo/' \
		-e '/^Comment\[/d' \
		-e 's/^Icon=.*/Icon=vortara-logo/' \
		"$lanzador"
fi

# Cargador de arranque: en UEFI se instala también el shim y el GRUB firmados
# (Secure Boot). Los paquetes salen del repositorio que va dentro de la ISO,
# así que funciona sin Internet.
helpers=/usr/share/calamares/helpers
sed -i 's/apt-get -y install grub-efi$/apt-get -y install grub-efi-amd64 grub-efi-amd64-signed shim-signed/' \
	"$helpers/calamares-bootloader-config"
grep -q 'grub-efi-amd64-signed' "$helpers/calamares-bootloader-config"

# Fuentes de APT del sistema instalado: se conservan las del sistema live
# (main, contrib, non-free, non-free-firmware y backports con su prioridad),
# en lugar de la lista reducida que escribe Debian.
cat > "$helpers/calamares-sources-final" <<'FIN'
#!/bin/sh
# Vortara: el sistema instalado conserva las fuentes de APT del sistema live.
exit 0
FIN
