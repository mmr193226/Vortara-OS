#!/bin/sh
# Vortara: saca del initramfs los drivers de gráficas y su firmware.
# Ocupan más de 100 MB y no hacen falta para montar el sistema: se cargan
# igual desde el disco al terminar el arranque. Así el arranque necesita
# mucha menos RAM, importante en equipos de 2 GB.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

for base in "$DESTDIR/usr/lib" "$DESTDIR/lib"; do
	for fw in amdgpu radeon nvidia i915 xe nouveau; do
		rm -rf "$base/firmware/$fw"
	done
	for mods in "$base"/modules/*/kernel/drivers/gpu/drm; do
		[ -d "$mods" ] || continue
		rm -rf "$mods/amd" "$mods/radeon" "$mods/nouveau" "$mods/i915" "$mods/xe"
	done
done
exit 0
