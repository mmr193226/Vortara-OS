# Valores por defecto de Vortara para Cinnamon: tema «Vortara» (cristal oscuro
# con acento teal, estilo Aero) y barra de tareas al estilo de Windows 7.
[org.cinnamon.desktop.interface]
gtk-theme='Vortara'
icon-theme='Papirus-Dark'
cursor-theme='Adwaita'
font-name='Noto Sans 10'

[org.cinnamon.desktop.wm.preferences]
theme='Vortara'
button-layout=':minimize,maximize,close'
titlebar-font='Noto Sans Bold 10'

[org.gnome.desktop.interface]
gtk-theme='Vortara'
icon-theme='Papirus-Dark'
color-scheme='prefer-dark'

[org.cinnamon.desktop.background]
picture-uri='file:///usr/share/backgrounds/vortara/aurora.png'
picture-options='zoom'
primary-color='#0B1F1D'

[org.cinnamon]
favorite-apps=['firefox-esr.desktop', 'nemo.desktop', 'org.gnome.Terminal.desktop']
# Barra inferior más alta, con iconos grandes (estilo Windows 7). La esquina de
# la derecha (cornerbar) muestra el escritorio.
panels-height=['1:44']
enabled-applets=['panel1:left:0:menu@cinnamon.org', 'panel1:left:1:grouped-window-list@cinnamon.org', 'panel1:right:0:systray@cinnamon.org', 'panel1:right:1:xapp-status@cinnamon.org', 'panel1:right:2:notifications@cinnamon.org', 'panel1:right:3:printers@cinnamon.org', 'panel1:right:4:removable-drives@cinnamon.org', 'panel1:right:5:keyboard@cinnamon.org', 'panel1:right:6:favorites@cinnamon.org', 'panel1:right:7:network@cinnamon.org', 'panel1:right:8:sound@cinnamon.org', 'panel1:right:9:power@cinnamon.org', 'panel1:right:10:calendar@cinnamon.org', 'panel1:right:11:cornerbar@cinnamon.org']

[org.cinnamon.theme]
name='Vortara'

[org.cinnamon.desktop.input-sources]
sources=[('xkb', 'es')]
