#!/bin/sh
set -e

mo=/usr/share/locale/es/LC_MESSAGES/grub.mo

completar_grub_es() {
	if [ -f "$mo.debian" ]; then
		/usr/libexec/vortara/grub-es-completar "$mo.debian" "$mo"
	fi
	# La entrada del firmware UEFI tiene el texto fijo en el script.
	if [ -f /etc/grub.d/30_uefi-firmware ]; then
		sed -i 's/^LABEL="UEFI Firmware Settings"$/LABEL="Configuración del firmware UEFI"/' \
			/etc/grub.d/30_uefi-firmware
	fi
}

case "$1" in
	configure)
		completar_grub_es
		gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
		# En un sistema ya instalado, aplicar el aspecto nuevo del menú.
		if [ -f /boot/grub/grub.cfg ] && command -v update-grub >/dev/null; then
			update-grub 2>/dev/null || true
		fi
		;;
	triggered)
		completar_grub_es
		;;
esac
