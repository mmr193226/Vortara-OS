#!/bin/sh
set -e

completar_grub() {
	/usr/libexec/vortara/grub-completar-traducciones
	# La entrada del firmware UEFI tiene el texto fijo en el script: se hace
	# traducible (versiones anteriores lo ponían siempre en español).
	if [ -f /etc/grub.d/30_uefi-firmware ]; then
		sed -i \
			-e 's/^LABEL="UEFI Firmware Settings"$/LABEL="$(gettext "UEFI Firmware Settings")"/' \
			-e 's/^LABEL="Configuración del firmware UEFI"$/LABEL="$(gettext "UEFI Firmware Settings")"/' \
			/etc/grub.d/30_uefi-firmware
	fi
}

case "$1" in
	configure)
		completar_grub
		gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
		# En un sistema ya instalado, aplicar el aspecto nuevo del menú.
		if [ -f /boot/grub/grub.cfg ] && command -v update-grub >/dev/null; then
			update-grub 2>/dev/null || true
		fi
		;;
	triggered)
		completar_grub
		;;
esac
