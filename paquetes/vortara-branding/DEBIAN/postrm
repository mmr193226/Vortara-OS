#!/bin/sh
set -e
mo=/usr/share/locale/es/LC_MESSAGES/grub.mo
if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
	# Quitar la traducción de Vortara y devolver la de Debian a su sitio.
	if [ -f "$mo.debian" ]; then
		rm -f "$mo"
	fi
	dpkg-divert --package vortara-branding --rename \
		--divert "$mo.debian" --remove "$mo" >/dev/null
fi
