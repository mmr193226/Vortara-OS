#!/usr/bin/python3 -I
# Vortara: completa las traducciones del menú de GRUB.
#
# Las traducciones de GRUB en Debian son antiguas (de 2019 a 2023) y les faltan
# los textos del menú de las versiones nuevas («Advanced options for...»,
# «Loading Linux...»). Para cada idioma de /usr/share/vortara/grub/traducciones.json
# lee el catálogo original, que vortara-branding aparta con dpkg-divert a
# grub.mo.debian, le añade lo que falta sin tocar lo demás y escribe grub.mo.
#
# Uso: grub-completar-traducciones
import json
import os
import struct

TRADUCCIONES = "/usr/share/vortara/grub/traducciones.json"
LOCALE = "/usr/share/locale"


def leer_mo(ruta):
    """Entradas del .mo tal cual (incluidas las de plural, «singular\\0plural»)."""
    with open(ruta, "rb") as f:
        mo = f.read()
    magia = struct.unpack("<I", mo[:4])[0]
    orden = "<" if magia == 0x950412DE else ">"
    _, n, pos_ids, pos_strs = struct.unpack(orden + "4I", mo[4:20])
    entradas = {}
    for i in range(n):
        lid, oid = struct.unpack(orden + "2I", mo[pos_ids + 8 * i:pos_ids + 8 * i + 8])
        lst, ost = struct.unpack(orden + "2I", mo[pos_strs + 8 * i:pos_strs + 8 * i + 8])
        entradas[mo[oid:oid + lid]] = mo[ost:ost + lst]
    return entradas


def escribir_mo(ruta, entradas):
    """Escribe el .mo con las claves ordenadas (gettext las busca por bisección)."""
    claves = sorted(entradas)
    n = len(claves)
    pos_ids, pos_strs = 7 * 4, 7 * 4 + n * 8
    datos = pos_strs + n * 8
    tabla, cuerpo = [], b""
    for k in claves:
        tabla.append((len(k), datos + len(cuerpo)))
        cuerpo += k + b"\0"
    for k in claves:
        tabla.append((len(entradas[k]), datos + len(cuerpo)))
        cuerpo += entradas[k] + b"\0"
    temporal = ruta + ".vortara-nuevo"
    with open(temporal, "wb") as f:
        f.write(struct.pack("<7I", 0x950412DE, 0, n, pos_ids, pos_strs, 0, 0))
        for longitud, posicion in tabla:
            f.write(struct.pack("<2I", longitud, posicion))
        f.write(cuerpo)
    os.replace(temporal, ruta)


def main():
    with open(TRADUCCIONES, encoding="utf-8") as f:
        idiomas = json.load(f)
    for idioma, nuevos in idiomas.items():
        carpeta = os.path.join(LOCALE, idioma, "LC_MESSAGES")
        origen = os.path.join(carpeta, "grub.mo.debian")
        if not os.path.isfile(origen):
            continue
        entradas = leer_mo(origen)
        for original, traduccion in nuevos.items():
            entradas.setdefault(original.encode("utf-8"), traduccion.encode("utf-8"))
        escribir_mo(os.path.join(carpeta, "grub.mo"), entradas)


if __name__ == "__main__":
    main()
